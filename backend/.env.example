# ============================================================
# Arecanut Snail Project — Backend Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- Supabase ---
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- JWT Secret (generate a random 32+ char string) ---
SECRET_KEY=your_super_secret_jwt_key_here_change_this

# --- Gemini API (for chatbot) ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Model Paths (relative to project root) ---
SNAIL_MODEL_PATH=models/snail_detection_best.pt
DISEASE_MODEL_PATH=models/arecanut_disease_best.pt
DAMAGE_MODEL_PATH=models/snail_damage_best.pt

# --- App Settings ---
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
